// Déploiement Cloudflare (Workers, fichiers statiques) : seul le dossier « site » est publié.
// Jamais « app » (espace cabinet) ni « assets » (photos d'origine des patients).
{
  "name": "dr-nouha-ksiksi",
  "compatibility_date": "2025-09-01",
  // Adresse publique en attendant le nom de domaine ; pas d'adresses d'aperçu par version
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
